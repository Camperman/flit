<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron (V8 JIT) under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Google Meet: microphone + camera. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Passkey/security-key sign-in over Bluetooth (caBLE). -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- Touch ID / Secure Enclave WebAuthn credentials (app.configureWebAuthn).
         Must match the keychainAccessGroup passed in src/main/index.ts. -->
    <key>keychain-access-groups</key>
    <array>
      <string>VZ44XQWQ84.com.gottaplaygames.flit.webauthn</string>
    </array>
  </dict>
</plist>
